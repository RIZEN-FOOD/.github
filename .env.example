# ─────────────────────────────────────────────
#  라이즌푸드 로컬 개발 환경변수 예시
#  이 파일을 복사해서 .env 로 만들고 값을 채운다.
#      cp .env.example .env
#  .env 는 절대 커밋하지 않는다.
# ─────────────────────────────────────────────

# ── PostgreSQL (docker-compose.yml 이 읽는다) ──
POSTGRES_DB=rizenfood
POSTGRES_USER=rizen
POSTGRES_PASSWORD=change-me-in-local
POSTGRES_PORT=5432

# ── Spring Boot (BE) ──
# 호스트에서 ./gradlew bootRun 으로 띄울 때 기준
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/rizenfood
DB_USERNAME=rizen
DB_PASSWORD=change-me-in-local

# ── Next.js (FE) ──
# NEXT_PUBLIC_ 접두사는 브라우저에 노출된다. 비밀값을 넣지 말 것.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ── 인증 ──
# 32바이트 이상. 아래 명령으로 만들 수 있다.
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# 운영(HTTPS)에서는 true 로 바꾼다.
JWT_SECURE_COOKIE=false

# ── 이미지 저장소 ──
# local | s3
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_URL=/uploads
# S3 를 쓸 때만 채운다. 공개 URL 은 버킷이 아니라 CloudFront 도메인이다.
S3_BUCKET=
CDN_BASE_URL=

# ── 초기 관리자 ──
# 관리자 계정이 하나도 없을 때만 쓰인다. 첫 기동 후에는 값을 지운다.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-at-least-8-chars
ADMIN_BOOTSTRAP_NAME=관리자

# Next.js 서버가 /api 를 프록시할 백엔드 주소 (브라우저에 노출되지 않음)
API_ORIGIN=http://localhost:8080

# 휴대폰 번호 암호화 키 (base64 32바이트). openssl rand -base64 32
PHONE_ENC_KEY=base64-encoded-32-byte-key

# 프론트 오리진 화이트리스트 (쉼표 구분). 운영은 실제 도메인만 넣는다.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3200

# ── 결제(포트원 PortOne V2) ─────────────────────────
# mock | portone. 키가 준비되면 portone 으로 바꾼다.
PAYMENT_PROVIDER=mock
# 서버 전용 비밀값(결제 검증·환불). 절대 프론트·저장소에 노출하지 않는다.
PORTONE_API_SECRET=
# 브라우저가 결제창을 여는 데 쓰는 공개값
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=

# ── 간편 로그인 (카카오·네이버) — 절차는 BE/deploy/SOCIAL_LOGIN.md ──
# 손님이 보는 사이트 주소(끝에 / 없이). 로컬은 화면 서버 주소.
OAUTH_REDIRECT_BASE=http://localhost:3200
# 비워 두면 그 제공자 버튼이 안 보인다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
